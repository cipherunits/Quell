<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Quell.ViewModels"
             xmlns:models="using:Quell.Models"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="350"
             x:Class="Quell.Components.SchemaPropertiesTableComponent"
             x:DataType="vm:SchemaPropertiesTableViewModel">

    <UserControl.Styles>
        <!-- Distinct Row Header / Index Column Cell Style with Prominent Divider Line -->
        <Style Selector="DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableGutterBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableGutterForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableGutterBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,2,1"/>
        </Style>

        <!-- Alternating Column Cell Colors (Compact Height) -->
        <Style Selector="DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableWhiteColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style Selector="DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableAltColBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableCellForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableCellBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Hover State on Rows -->
        <Style Selector="DataGridRow:pointerover DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:pointerover DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableHoverBackgroundBrush}"/>
        </Style>

        <!-- Selected Row Highlight -->
        <Style Selector="DataGridRow:selected DataGridCell.row-header-col">
            <Setter Property="Background" Value="{DynamicResource AppTableSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableSelectedForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.white-col">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
        </Style>
        <Style Selector="DataGridRow:selected DataGridCell.alt-col">
            <Setter Property="Background" Value="{DynamicResource AppTableActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableActiveForegroundBrush}"/>
        </Style>

        <!-- Column Header Styling with Prominent Titles (Compact Height) -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader:pointerover">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AppTableHeaderBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTableHeaderForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableHeaderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Styles>

    <!-- Reusable Table Schema & Column Properties Component with Alternating Columns -->
    <Border Background="{DynamicResource AppWorkspaceBrush}">
        <Grid RowDefinitions="Auto, *">
            
            <!-- 1. Header Toolbar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource AppSurfaceBrush}" 
                    BorderBrush="{DynamicResource AppBorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="6,4">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AppAccentBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ic:SymbolIcon Symbol="Table" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TableName, StringFormat='Table: {0}'}" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Columns.Count, StringFormat='{}{0} columns'}" FontSize="10" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBox Width="150" 
                                 Height="25" 
                                 FontSize="11" 
                                 Padding="6,3" 
                                 CornerRadius="4" 
                                 PlaceholderText="Filter columns..." 
                                 Text="{Binding FilterText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="classic-tool-btn" Command="{Binding CopyColumnNamesCommand}" ToolTip.Tip="Copy all column names to clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <ui:FASymbolIcon Symbol="Copy" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Column Names" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="classic-tool-btn" Command="{Binding $parent[TopLevel].((vm:MainViewModel)DataContext).GenerateTableDdlCommand}" ToolTip.Tip="Generate CREATE TABLE DDL script in Editor">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <ui:FASymbolIcon Symbol="Code" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Generate DDL" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Schema Columns DataGrid with Alternating Columns (RowHeight=25) -->
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding Columns}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      GridLinesVisibility="All" 
                      HorizontalGridLinesBrush="{DynamicResource AppTableGridLinesHorizontalBrush}" 
                      VerticalGridLinesBrush="{DynamicResource AppTableGridLinesVerticalBrush}"
                      CanUserResizeColumns="True" 
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      RowHeight="20">
                <DataGrid.Columns>
                    <!-- Col 0: Ordinal / Row # (Gutter style with prominent vertical line divider in front of number) -->
                    <DataGridTemplateColumn Header="ROW #" 
                                            CellStyleClasses="row-header-col"
                                            Width="56" 
                                            CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:TableColumnItem">
                                <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Ordinal}" 
                                               Foreground="{DynamicResource AppTableGutterForegroundBrush}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                    <!-- Clear vertical divider line right in front of the row number -->
                                    <Border Grid.Column="1" 
                                            Width="2" 
                                            Background="{DynamicResource AppTableDividerBrush}" 
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Key Indicator (Golden PK Badge & FK Link Badge) -->
                    <DataGridTemplateColumn Header="KEY" 
                                            CellStyleClasses="white-col"
                                            Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <Border Background="{DynamicResource AppTablePkBadgeBackgroundBrush}" 
                                            BorderBrush="{DynamicResource AppTablePkBadgeBorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="4,1"
                                            ToolTip.Tip="Primary Key (Unique Record Identifier)"
                                            IsVisible="{Binding IsPrimaryKey}">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <PathIcon Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="9" Height="9" Foreground="{DynamicResource AppTablePkColumnForegroundBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="PK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppTablePkBadgeForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E2E8F0" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="3" Padding="3,1" ToolTip.Tip="Foreign Key" IsVisible="{Binding IsForeignKey}">
                                        <TextBlock Text="FK" FontSize="9" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Column Name (Dimmer Off-White) -->
                    <DataGridTextColumn Header="COLUMN NAME" 
                                        CellStyleClasses="alt-col"
                                        Binding="{Binding Name}" 
                                        FontWeight="SemiBold"
                                        Width="160" />

                    <!-- Data Type (Pure White) -->
                    <DataGridTextColumn Header="DATA TYPE" 
                                        CellStyleClasses="white-col"
                                        Binding="{Binding DataType}" 
                                        Width="120" />

                    <!-- Max Length (Dimmer Off-White) -->
                    <DataGridTextColumn Header="LENGTH" 
                                        CellStyleClasses="alt-col"
                                        Binding="{Binding MaxLength}" 
                                        Width="80" />

                    <!-- Nullable (Pure White) -->
                    <DataGridCheckBoxColumn Header="NULLABLE" 
                                            CellStyleClasses="white-col"
                                            Binding="{Binding IsNullable}" 
                                            Width="90" />

                    <!-- Default Value (Dimmer Off-White) -->
                    <DataGridTextColumn Header="DEFAULT" 
                                        CellStyleClasses="alt-col"
                                        Binding="{Binding DefaultValue}" 
                                        Width="140" />

                    <!-- Description (Pure White) -->
                    <DataGridTextColumn Header="DESCRIPTION" 
                                        CellStyleClasses="white-col"
                                        Binding="{Binding Description}" 
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
